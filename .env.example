# ── Server & Session Security ───────────────────────────────────────
# Secret key used to cryptographically sign session cookies (generate a 32+ char random string)
SESSION_SECRET=generate_a_secure_random_64_character_hex_string_here

# ── Backend Configuration ──────────────────────────────────────────
# Python FastAPI Backend URL
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── MongoDB Atlas Connection ───────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# ── Razorpay Payment Gateway ────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# ── Python Backend (FastAPI) Environment ───────────────────────────
# Allowed CORS origins for the Python backend (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://ventwisebackend.vercel.app
ENVIRONMENT=production
